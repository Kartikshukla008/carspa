# ==========================================
# DOORSTEP CAR WASHING BOOKING PLATFORM
# Environment Configuration
# ==========================================

# 1. Django Backend
DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
# For local development without Docker, leave empty to default to SQLite
DATABASE_URL=postgres://carwash_user:carwash_secret_password@localhost:5432/carwash_db
POSTGRES_DB=carwash_db
POSTGRES_USER=carwash_user
POSTGRES_PASSWORD=carwash_secret_password

# Notifications (WhatsApp Cloud API / Email)
# When left blank, system runs in SIMULATED mode recording all dispatches to NotificationLog
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_NOTIFICATION_EMAIL=admin@lustreautospa.com
ADMIN_NOTIFICATION_PHONE=+919876543210

# Optional Email SMTP Settings
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Lustre AutoSpa <notifications@lustreautospa.com>"

# Payments (Razorpay Integration)
# By default, PAYMENTS_ENABLED=False enables Pay-On-Service (Cash/UPI upon doorstep completion)
PAYMENTS_ENABLED=False
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 2. Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
