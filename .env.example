# ==========================================
# DOORSTEP CAR WASHING BOOKING PLATFORM
# Environment Configuration
# ==========================================

# 1. Django Backend
DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
# For local development without Docker, leave empty to default to SQLite
DATABASE_URL=postgres://carwash_user:carwash_secret_password@localhost:5432/carwash_db
POSTGRES_DB=carwash_db
POSTGRES_USER=carwash_user
POSTGRES_PASSWORD=carwash_secret_password

# Notifications & Real OTP Gateways (WhatsApp / SMS / Email)
# -------------------------------------------------------------
# Option A: Meta Official WhatsApp Cloud API (https://developers.facebook.com/)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Option B: Twilio (Real SMS & WhatsApp worldwide, https://www.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=+14155238886

# Option C: Fast2SMS (Instant real OTP for Indian mobile numbers, https://www.fast2sms.com/)
FAST2SMS_API_KEY=

ADMIN_NOTIFICATION_EMAIL=admin@lustreautospa.com
ADMIN_NOTIFICATION_PHONE=+919876543210

# Optional Email SMTP Settings
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Lustre AutoSpa <notifications@lustreautospa.com>"

# Payments (Razorpay Payment Gateway for India)
# 1. Sign up / log in to https://dashboard.razorpay.com/
# 2. Go to Settings -> API Keys -> Generate Key (Starts with rzp_test_... in Test Mode)
# 3. For Webhooks: Settings -> Webhooks -> Add New Webhook:
#    URL: https://your-backend-domain.com/api/payments/razorpay/webhook/
#    Secret: Set your own secret phrase and enter below
#    Events: order.paid, payment.captured, payment.failed, refund.created
PAYMENTS_ENABLED=True
RAZORPAY_KEY_ID=rzp_test_TteHoSMDQXe5Mz
RAZORPAY_KEY_SECRET=1SRgMLh3jTGeuM1qBUUpXxi4
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# 2. Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
